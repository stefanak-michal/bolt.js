{
  "trailingComma": "es5",
  "tabWidth": 4,
  "singleQuote": true,
  "proseWrap": "preserve",
  "jsxSingleQuote": true,
  "arrowParens": "avoid",
  "printWidth": 120,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": ["*.json", "*.yml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
