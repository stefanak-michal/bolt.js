{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "strict": true,
    "module": "es6",
    "target": "es6",
    "allowJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
